# Replace this hostname; DNS must point directly to the media machine.
media1.example.com {
    @control path /api/*
    handle @control {
        # Replace with the main VPS's outbound public IP before enabling.
        @outside not remote_ip 192.0.2.10
        respond @outside 403
        reverse_proxy 127.0.0.1:4000
    }
    handle {
        reverse_proxy 127.0.0.1:4000
    }
}
